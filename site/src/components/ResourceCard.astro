---
import { repositoryFileUrl, type ProjectResource } from "../data/resources";

interface Props {
  resource: ProjectResource;
}

const { resource } = Astro.props;
---

<article class="resource-card">
  <div>
    <p class="eyebrow">Repository resource</p>
    <h2>{resource.title}</h2>
    <p>{resource.description}</p>
    <code>{resource.path}</code>
  </div>
  <a
    class="text-link"
    href={repositoryFileUrl(resource.path)}
    target="_blank"
    rel="noreferrer"
  >
    Open document <span aria-hidden="true">↗</span>
  </a>
</article>
