# Copy to .env and replace every value marked CHANGE_ME.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Local compose service credentials (CHANGE_ME before any shared deployment).
POSTGRES_USER=scrapeflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=scrapeflow
DATABASE_URL=postgresql+asyncpg://scrapeflow:CHANGE_ME@postgres:5432/scrapeflow
REDIS_URL=redis://redis:6379/0

# Required secrets. The API refuses to start if any is missing or shorter than 32 chars.
API_KEY_PEPPER=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
JWT_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
WEBHOOK_SECRET_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS

# Optional JWT signing-key rotation. Active key signs new tokens; previous keys
# are a JSON map of kid -> secret and verify older tokens until they expire.
JWT_ACTIVE_KID=primary
# JWT_PREVIOUS_KEYS={"old-kid":"a-32-plus-character-secret"}

# Browser execution. Workers only; the API never launches Chrome.
SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub
# Every browser and HTTP scrape leaves through this validating proxy.
EGRESS_PROXY_URL=http://egress-proxy:8888
EGRESS_PROXY_LISTEN_HOST=127.0.0.1
EGRESS_PROXY_LISTEN_PORT=8888
EGRESS_ALLOWED_PORTS=80,443

# Per-job upstream proxies. Disabled by default. Configure exactly one provider:
#   PROXY_STATIC_LIST=DE|http://user:pass@proxy-a:8080,US|http://user:pass@proxy-b:8080
#   PROXY_GATEWAY_URL=http://user-{country}:pass@gateway.example:8080
# Static entries may omit "COUNTRY|" for an any-country proxy. Gateway URLs may
# use one {country} placeholder and require PROXY_GATEWAY_COUNTRIES plus a
# default country for requests without proxy_country. Credentials stay in the
# environment and are never logged, stored in job results, or written to the DB.
PROXY_ENABLED=false
PROXY_STATIC_LIST=
PROXY_GATEWAY_URL=
PROXY_GATEWAY_COUNTRIES=
PROXY_GATEWAY_DEFAULT_COUNTRY=
PROXY_MAX_RETRIES=2
PROXY_HEALTH_CHECK_ENABLED=true
PROXY_HEALTH_TIMEOUT_SECONDS=3
PROXY_HEALTH_CACHE_SECONDS=30
PROXY_HEALTH_COOLDOWN_SECONDS=60
# With per-job proxies and remote Selenium Grid, the worker starts a local
# validating proxy that Grid must reach. Bind to the container interface and
# advertise the worker service name (compose sets these for the worker).
EGRESS_JOB_PROXY_BIND_HOST=127.0.0.1
EGRESS_JOB_PROXY_ADVERTISE_HOST=

# Job execution and egress limits.
JOB_TIMEOUT_SECONDS=120
JOB_LEASE_SECONDS=180
JOB_MAX_ATTEMPTS=2
JOB_REAPER_INTERVAL_SECONDS=30
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_BYTES=5000000
HTTP_MAX_REDIRECTS=5

# Automation steps and transient secrets. Secrets are AES-GCM sealed in Redis
# and deleted when the job ends; leave AUTOMATION_SECRET_KEY empty to derive
# the encryption key from JWT_SECRET via HKDF.
AUTOMATION_MAX_STEPS=500
AUTOMATION_MAX_DEPTH=3
AUTOMATION_SECRET_KEY=
AUTOMATION_SECRETS_TTL_SECONDS=960

# Plan quotas. Allowances live in packages/core/plans.py; these control the
# background repair interval for Redis counters and concurrency leases.
QUOTA_RECONCILE_INTERVAL_SECONDS=600

# Schedules and signed webhooks. WEBHOOK_SECRET_KEY (above) encrypts the
# per-organisation signing secret; it never hashes or logs that secret.
SCHEDULE_DISPATCH_INTERVAL_SECONDS=30
SCHEDULE_DISPATCH_BATCH_SIZE=100
WEBHOOK_DISPATCH_INTERVAL_SECONDS=15
WEBHOOK_DELIVERY_BATCH_SIZE=100
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_SECONDS=30
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_MAX_RESPONSE_BYTES=4096

# Artifact storage. Compose points this at MinIO; leave ARTIFACTS_ENDPOINT
# empty for the local filesystem (development and tests only).
ARTIFACTS_ENDPOINT=http://minio:9000
ARTIFACTS_BUCKET=scrapeflow
ARTIFACTS_ACCESS_KEY=CHANGE_ME
ARTIFACTS_SECRET_KEY=CHANGE_ME
ARTIFACTS_REGION=us-east-1
ARTIFACTS_USE_SSL=false
ARTIFACTS_RETENTION_DAYS=7
ARTIFACTS_MAX_BYTES=10000000
ARTIFACT_RETENTION_INTERVAL_SECONDS=3600
ARTIFACT_RETENTION_BATCH_SIZE=500

# MinIO service credentials (local compose only; mirror the image if your
# registry no longer serves the pinned tag).
MINIO_ROOT_USER=scrapeflow
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# Optional observability.
SENTRY_DSN=
METRICS_ENABLED=true

# Optional billing. Leave disabled until Stripe test keys are configured.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=
